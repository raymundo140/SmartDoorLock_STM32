#include "stm32h5xx.h"
#include "uart.h"

void USER_USART1_Init(void)
{
    // 1. Enable Clocks for GPIOB and USART1
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOBEN;
    RCC->APB2ENR |= RCC_APB2ENR_USART1EN;

    // 2. Set PB14 (TX) and PB15 (RX) to Alternate Function mode (AF7 = USART1)
    GPIOB->MODER &= ~((3U << (14 * 2)) | (3U << (15 * 2)));  // Clear
    GPIOB->MODER |=  (2U << (14 * 2)) | (2U << (15 * 2));    // AF mode

    GPIOB->AFR[1] &= ~((0xF << ((14 - 8) * 4)) | (0xF << ((15 - 8) * 4)));
    GPIOB->AFR[1] |=  (7 << ((14 - 8) * 4)) | (7 << ((15 - 8) * 4)); // AF7

    // Optional: Speed and output type
    GPIOB->OSPEEDR |= (3U << (14 * 2)) | (3U << (15 * 2));  // Very High speed
    GPIOB->OTYPER  &= ~((1U << 14) | (1U << 15));           // Push-pull
    GPIOB->PUPDR   &= ~((3U << (14 * 2)) | (3U << (15 * 2))); // No pull

    // 3. Configure USART1
    USART1->CR1 &= ~USART_CR1_UE;   // Disable USART for config

    USART1->BRR = 0x22B;  // For 64MHz clock, 115200 baud (can adjust)

    USART1->CR1 |= USART_CR1_TE | USART_CR1_RE;  // Enable TX & RX
    USART1->CR1 |= USART_CR1_UE;                 // Enable USART
}

// Redirect printf() to USART1
int _write(int file, char *ptr, int len)
{
    for (int i = 0; i < len; i++)
    {
        while (!(USART1->ISR & USART_ISR_TXE_TXFNF));
        USART1->TDR = ptr[i];
    }
    return len;
}
